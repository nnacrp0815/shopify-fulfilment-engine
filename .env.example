# Demo needs no secrets. npm start defaults to demo mode on 127.0.0.1:3000.
MODE=demo
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/engine.sqlite
RULES_PATH=./config/rules.example.json
# Required only in MODE=service. Obtain the app client secret through your own app.
# SHOPIFY_WEBHOOK_SECRET=
# SHOPIFY_SHOP=your-development-store.myshopify.com
# ADMIN_TOKEN=generate-a-long-random-token-at-least-32-characters
# Optional secret rotation: keep only for the rotation window.
# SHOPIFY_PREVIOUS_WEBHOOK_SECRET=
